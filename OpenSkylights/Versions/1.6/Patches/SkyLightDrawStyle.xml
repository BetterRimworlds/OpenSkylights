<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- drawStyleCategory exists from 1.6 onward, so a 1x1 skylight can be dragged in a line. -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="SkyLightA"]</xpath>
		<value>
			<drawStyleCategory>Default1D</drawStyleCategory>
		</value>
	</Operation>

</Patch>
